# Sample dotenv file.
NODE_ENV=production
LOG_LEVEL=info
PORT=8080

# Database
DATABASE_URL=postgres://api:s3cr3t@db:5432/api?sslmode=require
DATABASE_POOL_SIZE=16

# Cache
REDIS_URL=redis://cache:6379/0
CACHE_TTL_SECONDS=300

# Feature flags
FEATURE_TRACING=false
FEATURE_ASYNC_WRITES=true

# Secrets (placeholders — never commit real values)
JWT_SECRET="change-me"
POSTGRES_PASSWORD='change-me-too'
VSCE_PAT=

# Interpolated values
APP_NAME=bnw-api
APP_TAG=${APP_NAME}-1.4.2
